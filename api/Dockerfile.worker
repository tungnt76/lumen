FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM alpine:3.20
RUN apk add --no-cache ffmpeg ca-certificates && adduser -D worker
COPY --from=build /out/worker /worker
USER worker
ENV WORK_DIR=/tmp
ENTRYPOINT ["/worker"]
