# Copy to .env and fill in. Never commit the real file.

# Postgres (Neon or Supabase free tier; local: see docker-compose.yml)
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen?sslmode=disable

# TMDB v4 "API Read Access Token" (themoviedb.org > Settings > API)
TMDB_TOKEN=
TMDB_LANGUAGE=vi-VN
TMDB_REGION=VN

# openssl rand -hex 32
SESSION_SECRET=
# Where the Next.js site is served; admin writes from other origins are refused
SITE_ORIGIN=http://localhost:3000
# false only for local http development
COOKIE_SECURE=false

# Cloudflare R2 (R2 > Manage API tokens, Object Read & Write on this bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lumen-media
# Public URL of the bucket (custom domain or the r2.dev URL)
MEDIA_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Worker only
WORK_DIR=/tmp
DELETE_SOURCES=true

# Audio importer (cmd/import-audio)
# Contact shown to Wikisource/LibriVox in the User-Agent (defaults to SITE_ORIGIN)
IMPORT_CONTACT=
# Local TTS: Piper voice model, or a custom command that reads $IN (text) and writes $OUT (wav)
PIPER_MODEL=
# TTS_CMD=python3 scripts/tts_vieneu.py

# Testing only: point at local mocks
# TMDB_BASE_URL=http://127.0.0.1:18090/3
# R2_ENDPOINT=http://127.0.0.1:9000
